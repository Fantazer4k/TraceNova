# Optional API integrations for TraceNova

# GitHub: increases API rate limits and enables authenticated public-source searches.
GITHUB_TOKEN=

# Have I Been Pwned: required for breach-account lookups.
HIBP_API_KEY=

# ZeroBounce: optional email verification.
ZEROBOUNCE_API_KEY=

# Application settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
# Comma-separated origins, e.g. http://127.0.0.1:8000
CORS_ORIGINS=
